# ═══════════════════════════════════════
# STAGING — HTTP BASIC AUTH + INHERITS PROD RULES
# ═══════════════════════════════════════

AuthType Basic
AuthName "Staging — restricted"
# .htpasswd is managed out of band (generate with scripts/htpasswd-gen.sh,
# upload manually via SFTP/cPanel File Manager) — not part of the git deploy.
AuthUserFile /home/foma0863/staging.bimpact.eu/.htpasswd

# AutoSSL/Let's Encrypt HTTP domain-control validation must reach
# /.well-known/ unauthenticated, or certificate issuance/renewal fails.
SetEnvIf Request_URI "^/\.well-known/(pki-validation|acme-challenge)/" ALLOW_NOAUTH
Require valid-user
Require env ALLOW_NOAUTH

Options -Indexes
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On

# Let AutoSSL/Let's Encrypt HTTP domain-control validation through in plain HTTP —
# otherwise the force-HTTPS redirect below breaks certificate issuance/renewal.
RewriteCond %{REQUEST_URI} ^/\.well-known/(pki-validation|acme-challenge)/ [NC]
RewriteRule ^ - [L]

RewriteCond %{HTTPS} !on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteCond %{THE_REQUEST} \s/(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
